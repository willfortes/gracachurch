# URL pública do site, sem barra no final (usada em SEO, sitemap e links dos avisos)
APP_URL=http://localhost:8080
APP_ENV=local
APP_TIMEZONE=America/Sao_Paulo

# Banco MySQL (no Docker o host é "db")
DB_HOST=db
DB_PORT=3306
DB_NAME=gracachurch
DB_USER=graca
DB_PASS=troque-esta-senha
DB_ROOT_PASS=troque-esta-senha-root

# Código pedido para criar o primeiro administrador em /admin/setup
SETUP_TOKEN=troque-este-codigo

# Chaves dos avisos push (gere com: php bin/vapid.php)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@gracachurchpalhoca.org

# Quantos avisos o agendador envia por minuto
PUSH_BATCH=500
